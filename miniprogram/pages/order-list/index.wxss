.container {
  padding: 24rpx;
}

.block {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.filter-active {
  background: #d9a441;
  color: #2f2a26;
}

.secondary-button {
  margin-top: 12rpx;
  background: #efe6d4;
  color: #2f2a26;
}

.order-card {
  margin-bottom: 16rpx;
}

.pay-btn {
  margin-top: 6rpx;
  background: #d9a441;
  color: #2f2a26;
}

.detail-tip {
  margin-top: 8rpx;
  color: #7c9a6d;
}

.order-row {
  display: flex;
  margin-bottom: 8rpx;
}

.label {
  width: 110rpx;
  color: #6b604f;
}

.empty-card {
  text-align: center;
}

.empty-title {
  color: #2f2a26;
  font-size: 30rpx;
}

.empty-subtitle {
  color: #7a6d5a;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.status-warn {
  color: #9a6700;
  background: #fff5d6;
}

.status-success {
  color: #1f7a3b;
  background: #e9f8ee;
}

.status-info {
  color: #1f5f8f;
  background: #eaf4fb;
}

.status-done {
  color: #5a4a2e;
  background: #f6efe3;
}

.status-muted {
  color: #7a6d5a;
  background: #f1ede8;
}
