<view class="container">
  <view wx:if="{{detail}}" class="card block">
    <view class="title">订单详情</view>
    <view class="row"><text class="label">订单号</text><text>{{detail.orderNo}}</text></view>
    <view class="row"><text class="label">业务状态</text><text class="status-tag {{detail.orderStatusClass}}">{{detail.orderStatusLabel}}</text></view>
    <view class="row"><text class="label">支付状态</text><text class="status-tag {{detail.payStatusClass}}">{{detail.payStatusLabel}}</text></view>
    <view class="row"><text class="label">订单金额</text><text>￥{{detail.displayAmount}}</text></view>
    <view class="row"><text class="label">创建时间</text><text>{{detail.displayCreatedAt}}</text></view>
    <view class="row" wx:if="{{detail.displayPaidAt}}"><text class="label">支付时间</text><text>{{detail.displayPaidAt}}</text></view>
    <button
      wx:if="{{detail.orderStatus === 'PENDING_PAY'}}"
      class="pay-btn"
      loading="{{paying}}"
      disabled="{{paying}}"
      bindtap="onRepay"
    >
      去支付
    </button>
  </view>

  <view wx:if="{{timeline.length > 0}}" class="card block">
    <view class="title">状态流转</view>
    <block wx:for="{{timeline}}" wx:key="key">
      <view class="timeline-item">
        <view class="dot {{item.dotClass}}"></view>
        <view class="timeline-content">
          <view class="timeline-label">{{item.label}}</view>
          <view class="timeline-time">{{item.time}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{detail && detail.items && detail.items.length > 0}}" class="card block">
    <view class="title">商品明细</view>
    <block wx:for="{{detail.items}}" wx:key="productId">
      <view class="item-row">
        <view class="item-name">{{item.productName}}</view>
        <view class="item-meta">￥{{item.displayPrice}} x {{item.quantity}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{detail && detail.items && detail.items.length === 0}}" class="card block empty-item-card">
    <view class="empty-item-text">该订单暂无商品明细</view>
  </view>

  <view wx:if="{{!loading && !detail}}" class="card">订单不存在</view>
</view>
