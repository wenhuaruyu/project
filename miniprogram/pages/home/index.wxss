.block {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  margin-bottom: 16rpx;
  color: #7a6d5a;
}

.input {
  width: 100%;
  height: 76rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e7dac3;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fffdf8;
}

.row {
  display: flex;
  margin-bottom: 12rpx;
}

.label {
  width: 120rpx;
  color: #7a6d5a;
}
