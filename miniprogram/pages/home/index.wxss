.block {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  margin-bottom: 16rpx;
  color: #7a6d5a;
}

.input {
  width: 100%;
  height: 76rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e7dac3;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fffdf8;
}

.row {
  display: flex;
  margin-bottom: 12rpx;
}

.label {
  width: 120rpx;
  color: #7a6d5a;
}

.secondary-button {
  margin-top: 10rpx;
  background: #efe6d4;
  color: #2f2a26;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.action-btn {
  width: 32%;
  margin-top: 0;
  font-size: 24rpx;
  padding: 0;
}
