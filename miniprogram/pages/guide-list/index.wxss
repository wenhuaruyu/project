.container {
  padding: 24rpx;
}

.block {
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e7dac3;
  border-radius: 12rpx;
  background: #fffdf8;
}

.search-btn {
  margin-left: 8rpx;
}

.group-title {
  color: #7a6d5a;
  margin-bottom: 8rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.filter-active {
  background: #d9a441;
  color: #2f2a26;
}

.guide-card {
  margin-bottom: 14rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.guide-meta {
  color: #6b604f;
  margin-bottom: 6rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.category-tag {
  color: #5a4a2e;
  background: #f6efe3;
}

.distance-tag {
  color: #1f5f8f;
  background: #eaf4fb;
}

.heat-high {
  color: #a33a00;
  background: #ffe9dc;
}

.heat-mid {
  color: #9a6700;
  background: #fff5d6;
}

.heat-low {
  color: #556270;
  background: #edf1f5;
}

.guide-tip {
  margin-top: 8rpx;
  color: #7c9a6d;
}

.empty-card {
  text-align: center;
}

.secondary-button {
  margin-top: 10rpx;
  background: #efe6d4;
  color: #2f2a26;
}
