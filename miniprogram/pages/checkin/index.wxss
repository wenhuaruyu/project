.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  color: #7a6d5a;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 76rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e7dac3;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fffdf8;
}

.upload-block {
  margin-bottom: 16rpx;
}

.upload-title {
  margin-bottom: 10rpx;
  color: #5a4e3f;
}

.upload-button {
  margin-bottom: 10rpx;
  background: #efe6d4;
  color: #2f2a26;
}

.preview {
  width: 220rpx;
  height: 140rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e0d1ba;
}

.result-card {
  margin-top: 20rpx;
}

.row {
  display: flex;
  margin-bottom: 12rpx;
}

.label {
  width: 180rpx;
  color: #7a6d5a;
}
