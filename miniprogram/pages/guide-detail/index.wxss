.container {
  padding: 24rpx;
}

.block {
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #2f2a26;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.meta {
  color: #6b604f;
  margin-bottom: 8rpx;
}

.paragraph {
  color: #2f2a26;
  line-height: 1.7;
}

.action-row {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.action-btn {
  width: 48%;
}

.secondary-button {
  background: #efe6d4;
  color: #2f2a26;
}
